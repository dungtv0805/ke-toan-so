# tax-service — bảng kê thuế và tải hóa đơn từ cổng Thuế
TAX_SERVICE_PORT=3009

# Khóa mã hóa mật khẩu cổng Thuế của doanh nghiệp (BẮT BUỘC khi dùng tải hóa đơn).
# Chuỗi hex 64 ký tự. Sinh khóa mới:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MẤT KHÓA = MẤT TOÀN BỘ MẬT KHẨU ĐÃ LƯU.
#
# ĐỂ TRỐNG Ở ĐÂY LÀ CỐ Ý: file này có trong git, khóa thật chỉ nằm trên máy chủ
# tại env/tax.env. Để trống thì lưu mật khẩu cổng Thuế sẽ báo lỗi rõ ràng, còn
# đặt sẵn một khóa dùng chung thì mọi bản cài đều mã hóa bằng cùng một khóa.
CONG_THUE_KEY=

# Số request song song tối đa tới cổng Thuế. Cổng là hệ thống nhà nước dùng
# chung cả nước — tăng lên là con đường ngắn nhất tới việc bị chặn IP.
GDT_CONCURRENCY=2

# Tự động giải captcha cổng Thuế. Để trống = chế độ nhập tay (mặc định).
# Hỗ trợ: 2captcha | anticaptcha
#
# BẮT BUỘC khi muốn lịch tải chạy mà không cần người: token cổng Thuế sống ~1
# giờ nên lịch 6h30 sáng luôn phải đăng nhập lại, mà đăng nhập thì cần captcha.
#
# Cần cài thêm gói rasterize SVG trong container (xem skill db-deploy):
#   npm install --no-save --legacy-peer-deps @resvg/resvg-js
CAPTCHA_PROVIDER=
CAPTCHA_API_KEY=
