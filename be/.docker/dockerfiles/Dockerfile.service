# Combined Dockerfile for building individual services
# Usage: docker build --build-arg SERVICE_NAME=auth --build-arg PORT=3001 -f Dockerfile.service ..

# ============================================
# Stage 1: Builder
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install all dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Build argument for service name
ARG SERVICE_NAME=gateway

# Build the specific service
RUN yarn build:${SERVICE_NAME}

# ============================================
# Stage 2: Production Dependencies
# ============================================
FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json yarn.lock ./

# Install production dependencies only
RUN yarn install --frozen-lockfile --production && \
    yarn cache clean

# ============================================
# Stage 3: Runner with PM2
# ============================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache dumb-init curl && \
    npm install -g pm2 && \
    rm -rf /var/cache/apk/* /root/.npm

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

# Copy production dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy built application
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

# Copy PM2 config
COPY .docker/pm2/ecosystem.config.js ./ecosystem.config.js

# Set ownership
RUN chown -R nestjs:nodejs /app

USER nestjs

# Build arguments
ARG SERVICE_NAME=gateway
ARG PORT=3000

ENV NODE_ENV=production
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PORT=${PORT}

EXPOSE ${PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "pm2-runtime ecosystem.config.js --only $SERVICE_NAME"]
